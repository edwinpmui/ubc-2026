# Used by docker-compose.arc.yml. Copy to .env and fill in.

# Wallet that deploys the Penny contract (needs a little testnet USDC for gas).
DEPLOYER_PRIVATE_KEY=

# Output of the deploy step.
PENNY_CONTRACT_ADDRESS=

# Funded wallet that pays welcome bonuses and relays gas-free pay-link claims. Optional.
TREASURY_PRIVATE_KEY=
WELCOME_BONUS=1

# Long random strings, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
KEY_ENCRYPTION_SECRET=

ARC_RPC_URL=https://rpc.testnet.arc.network
SECURE_COOKIES=false
